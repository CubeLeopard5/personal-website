<!DOCTYPE html>
<!-- Blog post scaffold. Copy into en/blog/ or fr/blog/ and rename to <slug>.html.
     Every [PLACEHOLDER] below must be replaced — [LANG] is "en" or "fr" and must
     match the folder you copied this into. The paths assume that depth, so they
     work unchanged in either language. -->
<html lang="[LANG]">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="[ARTICLE DESCRIPTION - Update this with a brief summary of your blog post]">
    <meta name="keywords" content="[KEYWORDS - e.g., .NET, Software Development, Clean Architecture]">
    <meta name="author" content="Adrien Michaud">
    <title>[ARTICLE TITLE] | Adrien Michaud</title>
    <!-- Remove this line to publish. Until then the draft stays out of search results. -->
    <meta name="robots" content="noindex">
    <link rel="preload" href="../../fonts/inter-variable.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="../../main.css">
    <link rel="icon" type="image/svg+xml" href="../../images/favicon.svg">
    <link rel="canonical" href="https://www.michaud-developpement-informatique.fr/[LANG]/blog/[SLUG].html">
    <!-- Drop the two lines below if the article exists in one language only. -->
    <link rel="alternate" hreflang="en" href="https://www.michaud-developpement-informatique.fr/en/blog/[SLUG].html">
    <link rel="alternate" hreflang="fr" href="https://www.michaud-developpement-informatique.fr/fr/blog/[SLUG].html">

    <!-- Open Graph / social sharing -->
    <meta property="og:type" content="article">
    <meta property="og:site_name" content="Adrien Michaud">
    <meta property="og:title" content="[ARTICLE TITLE]">
    <meta property="og:description" content="[ARTICLE DESCRIPTION]">
    <meta property="og:url" content="https://www.michaud-developpement-informatique.fr/[LANG]/blog/[SLUG].html">
    <meta property="og:image" content="https://www.michaud-developpement-informatique.fr/images/og-image.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="[ARTICLE TITLE]">
    <meta name="twitter:description" content="[ARTICLE DESCRIPTION]">
    <meta name="twitter:image" content="https://www.michaud-developpement-informatique.fr/images/og-image.png">

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": "[ARTICLE TITLE]",
      "description": "[ARTICLE DESCRIPTION]",
      "datePublished": "[YYYY-MM-DD]",
      "author": { "@type": "Person", "name": "Adrien Michaud", "url": "https://www.michaud-developpement-informatique.fr/[LANG]/" },
      "publisher": { "@type": "Person", "name": "Adrien Michaud" },
      "image": "https://www.michaud-developpement-informatique.fr/images/og-image.png",
      "mainEntityOfPage": "https://www.michaud-developpement-informatique.fr/[LANG]/blog/[SLUG].html"
    }
    </script>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="container nav-container">
            <a href="../index.html" class="nav-brand">AM</a>
            <button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false">
                <span class="hamburger-line"></span>
                <span class="hamburger-line"></span>
                <span class="hamburger-line"></span>
            </button>
            <ul class="nav-menu" id="nav-menu">
                <li><a href="../index.html#about" class="nav-link">About</a></li>
                <li><a href="../index.html#experience" class="nav-link">Experience</a></li>
                <li><a href="../index.html#projects" class="nav-link">Projects</a></li>
                <li><a href="../index.html#skills" class="nav-link">Skills</a></li>
                <li><a href="index.html" class="nav-link">Blog</a></li>
                <li><a href="../index.html#contact" class="nav-link">Contact</a></li>
                <!-- [OTHERLANG] is the language you did NOT copy this into. -->
                <li class="nav-lang"><a href="../../[OTHERLANG]/blog/[SLUG].html" class="nav-link" hreflang="[OTHERLANG]" lang="[OTHERLANG]">[OTHERLANG uppercased]</a></li>
            </ul>
        </div>
    </nav>

    <!-- Blog Post Header -->
    <header class="blog-post-header">
        <div class="container">
            <h1 class="blog-post-title">[YOUR ARTICLE TITLE HERE]</h1>
            <div class="blog-post-meta">
                <span class="blog-date">[DATE - e.g., January 15, 2026]</span>
                <div class="blog-tags">
                    <span class="blog-tag">[TAG 1]</span>
                    <span class="blog-tag">[TAG 2]</span>
                    <!-- Add more tags as needed -->
                </div>
            </div>
        </div>
    </header>

    <!-- Blog Post Content -->
    <main class="blog-post-content">
        <div class="container">
            <a href="index.html" class="blog-back-link">← Back to Blog</a>

            <!-- Your article content starts here -->

            <p>
                This is a paragraph. Write your introduction here. Explain what the article is about and what readers will learn.
            </p>

            <h2>Main Section Heading</h2>

            <p>
                Write your content here. You can include multiple paragraphs, code examples, lists, and more.
            </p>

            <h3>Subsection Heading</h3>

            <p>
                More detailed content for this subsection.
            </p>

            <h2>Code Examples</h2>

            <p>
                You can include inline code like <code>var example = "code";</code> or multi-line code blocks:
            </p>

            <pre><code>public class Example
{
    public string Property { get; set; }

    public void Method()
    {
        // Your code here
    }
}</code></pre>

            <h2>Lists</h2>

            <p>Use bullet points for unordered lists:</p>

            <ul>
                <li>First item</li>
                <li>Second item</li>
                <li>Third item</li>
            </ul>

            <p>Use numbers for ordered lists:</p>

            <ol>
                <li>Step one</li>
                <li>Step two</li>
                <li>Step three</li>
            </ol>

            <h2>Conclusion</h2>

            <p>
                Wrap up your article with a conclusion that summarizes the key points and perhaps suggests next steps or further reading.
            </p>

            <!-- Your article content ends here -->
        </div>
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p>&copy; 2026 Adrien Michaud. All rights reserved.</p>
            <p>.NET & Full Stack Developer based in Neuchâtel, Switzerland</p>
        </div>
    </footer>

    <script src="../../main.js"></script>
</body>
</html>
